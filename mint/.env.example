# ─── Network ────────────────────────────────────────────────────────────────
# mainnet-beta or devnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
# Server-side RPC (use a paid provider like Helius/Triton for production)
SOLANA_RPC=https://api.mainnet-beta.solana.com

# ─── Payment token (the SPL token users pay with) ───────────────────────────
NEXT_PUBLIC_PAYMENT_MINT=7Jka23K4r8Lw5FC47HTB2TVdikFbfVBKGU1eP6Fdbrrr
# Override decimals if Jupiter / on-chain lookup fails (otherwise auto)
NEXT_PUBLIC_PAYMENT_DECIMALS=

# Treasury wallet that receives the SPL payments
NEXT_PUBLIC_TREASURY_WALLET=ReplaceWithYourTreasurySolanaPubkey

# ─── Mint authority (server-side, NEVER ship to the client) ─────────────────
# Base58-encoded secret key for the keypair that signs NFT mints + collection updates
MINT_AUTHORITY_SECRET=ReplaceWithBase58SecretKey

# ─── Per-tier mpl-core Collection addresses (filled in after running create-collections) ─
NEXT_PUBLIC_COLLECTION_TIER1=
NEXT_PUBLIC_COLLECTION_TIER2=
NEXT_PUBLIC_COLLECTION_TIER3=

# ─── Pricing source ─────────────────────────────────────────────────────────
# Jupiter price API base (lite is fine for low volume; switch to api.jup.ag for prod)
JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v2
# Optional fixed override (USD per 1 token) — bypasses Jupiter when set
PRICE_OVERRIDE_USD=

# ─── Asset metadata (off-chain JSON URIs you upload yourself) ───────────────
NEXT_PUBLIC_TIER1_METADATA_URI=https://your-cdn/cheeto-tier1.json
NEXT_PUBLIC_TIER2_METADATA_URI=https://your-cdn/cheeto-tier2.json
NEXT_PUBLIC_TIER3_METADATA_URI=https://your-cdn/cheeto-tier3.json
